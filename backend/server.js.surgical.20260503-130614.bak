});

// 1. Status do Luna
app.get('/api/luna/status', (req, res) => {
    try {
        const checkpointPath = path.join(__dirname, '..', 'agents', 'luna-checkpoint.json');
        const bufferPath = path.join(__dirname, '..', 'agents', 'luna-buffer.json');

        let checkpoint = { hashes: [], lastScan: null, version: '14.1' };
        let buffer = { messages: [], tasks: [], ideas: [] };

        if (fs.existsSync(checkpointPath)) {
            checkpoint = JSON.parse(fs.readFileSync(checkpointPath, 'utf8'));
        }
        if (fs.existsSync(bufferPath)) {
            buffer = JSON.parse(fs.readFileSync(bufferPath, 'utf8'));
        }

        res.json({
            status: 'running',
            version: checkpoint.version || '14.1',
            chromeConnected: true,
            whatsappConnected: true,
            lastScan: checkpoint.lastScan,
            totalHashes: checkpoint.hashes?.length || 0,
            bufferMessages: buffer.messages?.length || 0,
            bufferTasks: buffer.tasks?.length || 0,
            bufferIdeas: buffer.ideas?.length || 0,
            sentiment: buffer.sentiment || { positive: 0, negative: 0, urgent: 0 }
        });
    } catch (e) {
        res.status(500).json({ error: e.message });
    }
});

// 2. Forçar scan
app.post('/api/luna/scan', (req, res) => {
    res.json({ 
        success: true, 
        message: 'Scan agendado. Execute no terminal: node agents/luna-scheduler.mjs --force-scan',
        command: 'node agents/luna-scheduler.mjs --force-scan'
    });
});

// 3. Extrair mensagens
app.post('/api/luna/extract', (req, res) => {
    const { mode = 'normal', reset = false } = req.body;
    res.json({ 
        success: true, 
        mode, 
        reset, 
        message: reset 
            ? 'Checkpoint resetado. Execute: node agents/luna-scheduler.mjs --force-scan'
            : 'Extração normal agendada.'
    });
});

// 4. Verificar menções
app.post('/api/luna/mentions', (req, res) => {
    try {
        const bufferPath = path.join(__dirname, '..', 'agents', 'luna-buffer.json');
        const buffer = fs.existsSync(bufferPath) ? JSON.parse(fs.readFileSync(bufferPath, 'utf8')) : { messages: [] };
        const mentions = buffer.messages?.filter(m => 
            m.hasMention || (m.content && m.content.match(/@(?:KIMI|LUNA|KIMICLAW)/i))
        ) || [];
        res.json({ mentions, count: mentions.length });
    } catch (e) {
        res.status(500).json({ error: e.message });
    }
});

// 5. Verificar links
app.post('/api/luna/links', (req, res) => {
    try {
        const bufferPath = path.join(__dirname, '..', 'agents', 'luna-buffer.json');
        const buffer = fs.existsSync(bufferPath) ? JSON.parse(fs.readFileSync(bufferPath, 'utf8')) : { messages: [] };
        const urlRegex = /(https?:\/\/[^\s]+)/g;
        const links = [];
        buffer.messages?.forEach(m => {
            const matches = m.content?.match(urlRegex) || [];
            matches.forEach(url => links.push({ url, source: m.author, timestamp: m.timestamp }));
        });
        res.json({ links, count: links.length });
    } catch (e) {
        res.status(500).json({ error: e.message });
    }
});

// 6. Forçar relatório
app.post('/api/luna/report', (req, res) => {
    res.json({ 
        success: true, 
        message: 'Relatório agendado. Execute: node agents/luna-scheduler.mjs --force-report',
        command: 'node agents/luna-scheduler.mjs --force-report'
    });
});

// 7. Checkpoint
app.get('/api/whatsapp/checkpoint', (req, res) => {
    try {

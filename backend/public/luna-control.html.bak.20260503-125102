<script>
(() => {
  const LS_KEY = 'luna_engine_state';
  let pollTimer = null;
  let engineOn = (localStorage.getItem(LS_KEY) || 'on') === 'on';

  const dbg = (...args) => console.log('[LUNA-CC]', ...args);

  async function api(url, options = {}) {
    const endpoint = url.replace(/\/\/+/, '/');
    dbg('fetch', endpoint, options);
    try {
      const response = await fetch(endpoint, options);
      const text = await response.text();
      let data;
      try { data = JSON.parse(text); } catch { data = { raw: text }; }
      dbg('resp', endpoint, response.status, data);
      if (!response.ok) throw new Error(data.error || `HTTP ${response.status}`);
      return data;
    } catch (err) {
      dbg('error', endpoint, err);
      const wsText = document.getElementById('ws-status-text');
      if (wsText) wsText.textContent = `ERRO: ${err.message}`;
      throw err;
    }
  }

  function setVisualState(on) {
    const dot = document.getElementById('luna-status-indicator');
    const wsDot = document.getElementById('ws-status-dot');
    const wsText = document.getElementById('ws-status-text');
    if (dot) { dot.classList.remove('status-online', 'status-offline'); dot.classList.add(on ? 'status-online' : 'status-offline'); }
    if (wsDot) { wsDot.classList.remove('bg-green-500', 'bg-red-500', 'bg-yellow-500'); wsDot.classList.add(on ? 'bg-green-500' : 'bg-red-500'); }
    if (wsText) wsText.textContent = on ? '● OPERACIONAL' : '● OFFLINE';
  }

  async function refreshDashboard() {
    if (!engineOn) { setVisualState(false); return; }
    try {
      const status = await api('/api/luna/status');
      const cp = await api('/api/whatsapp/checkpoint');
      const bufferRaw = await api('/api/whatsapp/buffer');
      const messages = bufferRaw.messages || bufferRaw.buffer?.messages || [];

      setVisualState(status.status === 'running');

      const up = document.getElementById('system-uptime');
      if (up) up.textContent = Uptime: s;

      const scans = document.getElementById('last-scan-time');
      if (scans) scans.textContent = cp.lastScan || '--';

      const msgMetric = document.getElementById('metric-messages');
      if (msgMetric) msgMetric.textContent = String(messages.length);
    } catch (_) {
      setVisualState(false);
    }
  }

  function startPolling() {
    if (pollTimer) clearInterval(pollTimer);
    refreshDashboard();
    pollTimer = setInterval(refreshDashboard, 3000);
  }

  async function startEngine() {
    await api('/api/luna/start', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
    engineOn = true;
    localStorage.setItem(LS_KEY, 'on');
    setVisualState(true);
    startPolling();
  }

  async function stopEngine() {
    await api('/api/luna/stop', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
    engineOn = false;
    localStorage.setItem(LS_KEY, 'off');
    if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
    setVisualState(false);
  }

  function mountButtons() {
    const host = document.querySelector('header .flex.items-center.gap-3') || document.querySelector('header .flex.items-center.justify-between');
    if (!host || document.getElementById('btn-engine-on')) return;

    const onBtn = document.createElement('button');
    onBtn.id = 'btn-engine-on';
    onBtn.className = 'flex items-center gap-2 px-3 py-2 rounded-lg bg-emerald-900/30 border border-emerald-500/30 hover:bg-emerald-900/50 transition-all text-sm';
    onBtn.textContent = 'LIGAR ENGINE';
    onBtn.onclick = startEngine;

    const offBtn = document.createElement('button');
    offBtn.id = 'btn-engine-off';
    offBtn.className = 'flex items-center gap-2 px-3 py-2 rounded-lg bg-red-900/30 border border-red-500/30 hover:bg-red-900/50 transition-all text-sm';
    offBtn.textContent = 'DESLIGAR ENGINE';
    offBtn.onclick = stopEngine;

    host.prepend(offBtn);
    host.prepend(onBtn);
  }

  document.addEventListener('DOMContentLoaded', () => {
    mountButtons();
    if (engineOn) startPolling(); else setVisualState(false);
  });
})();
</script>
<script>
(function(){
  const LS_KEY='luna_engine_state';
  let poll=null;
  const state={on:(localStorage.getItem(LS_KEY)||'on')==='on'};

  const log=(...a)=>console.log('[LUNA-CTRL]',...a);
  async function api(url,opts={}){
    log('fetch',url,opts);
    const r=await fetch(url,opts);
    const t=await r.text();
    let d; try{d=JSON.parse(t)}catch{d={raw:t}};
    log('resp',url,r.status,d);
    if(!r.ok) throw new Error((d&&d.error)||('HTTP '+r.status));
    return d;
  }

  function setStatus(on){
    const ws=document.getElementById('ws-status-text');
    const dot=document.getElementById('ws-status-dot');
    if(ws) ws.textContent=on?'● OPERACIONAL':'● OFFLINE';
    if(dot){dot.classList.remove('bg-green-500','bg-red-500','bg-yellow-500');dot.classList.add(on?'bg-green-500':'bg-red-500');}
  }

  async function refresh(){
    if(!state.on){ setStatus(false); return; }
    try{
      const s=await api('/api/luna/status');
      setStatus(s.status==='running');
    }catch(e){ setStatus(false); }
  }

  function runPolling(){ if(poll) clearInterval(poll); refresh(); poll=setInterval(refresh,3000); }

  async function startEngine(){ await api('/api/luna/start',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'}); state.on=true; localStorage.setItem(LS_KEY,'on'); runPolling(); }
  async function stopEngine(){ await api('/api/luna/stop',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'}); state.on=false; localStorage.setItem(LS_KEY,'off'); if(poll){clearInterval(poll);poll=null;} setStatus(false); }
  async function restartEngine(){ await stopEngine(); setTimeout(startEngine,1200); }

  function mount(){
    const host=document.querySelector('header .flex.items-center.gap-3');
    if(!host || document.getElementById('btn-engine-on')) return;
    const mk=(id,txt,cls,fn)=>{const b=document.createElement('button');b.id=id;b.className=cls;b.textContent=txt;b.onclick=fn;return b;};
    host.prepend(mk('btn-engine-off','DESLIGAR ENGINE','flex items-center gap-2 px-3 py-2 rounded-lg bg-red-900/30 border border-red-500/30 text-red-300 text-sm',stopEngine));
    host.prepend(mk('btn-engine-restart','REINICIAR ENGINE','flex items-center gap-2 px-3 py-2 rounded-lg bg-amber-900/30 border border-amber-500/30 text-amber-300 text-sm',restartEngine));
    host.prepend(mk('btn-engine-on','LIGAR ENGINE','flex items-center gap-2 px-3 py-2 rounded-lg bg-emerald-900/30 border border-emerald-500/30 text-emerald-300 text-sm',startEngine));
  }

  document.addEventListener('DOMContentLoaded',()=>{ mount(); if(state.on) runPolling(); else setStatus(false); });
})();
</script>

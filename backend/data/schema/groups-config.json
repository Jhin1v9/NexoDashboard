  "globalRules": {
    "description": "Regras que se aplicam a TODOS os grupos, independente de config individual.",
    "rules": [
      {
        "id": "rule-001",
        "name": "NUNCA falar em grupo de cliente",
        "condition": "group.type == 'client'",
        "action": "block",
        "severity": "critical",
        "message": "🚫 BLOQUEADO: Tentativa de envio em grupo de cliente. Luna NUNCA fala com clientes diretamente.",
        "logLevel": "error",
        "alertAdmins": true
      },
      {
        "id": "rule-002",
        "name": "Reports SÓ no Production",
        "condition": "report.destination != 'nexo-production-2026'",
        "action": "redirect",
        "severity": "warning",
        "message": "⚠️ REDIRECIONADO: Report destinado a grupo não-autorizado. Enviando para Production.",
        "logLevel": "warn",
        "alertAdmins": false
      },
      {
        "id": "rule-003",
        "name": "Mensagens de sistema só no internal",
        "condition": "message.type == 'system' AND group.type != 'internal'",
        "action": "block",
        "severity": "high",
        "message": "🚫 BLOQUEADO: Mensagem de sistema em grupo não-interno.",
        "logLevel": "error",
        "alertAdmins": true
      }
    ]
  },
